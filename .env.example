# ========================================
# 虹远水利工程有限公司官网 - 环境变量配置
# ========================================
# 使用方法：复制此文件为 .env 并修改相应配置
# cp .env.example .env

# ----------------------------------------
# 数据库配置（PostgreSQL）
# ----------------------------------------

# 数据库用户名
POSTGRES_USER=halo

# 数据库密码（请修改为强密码）
POSTGRES_PASSWORD=halo_password_change_me

# 数据库名称
POSTGRES_DB=halo

# ----------------------------------------
# Halo CMS 配置
# ----------------------------------------

# 网站外部访问地址（部署时修改为实际域名）
HALO_EXTERNAL_URL=http://localhost:8090

# 超级管理员用户名（请修改为实际用户名）
HALO_SECURITY_INITIALIZER_SUPERADMINUSERNAME=CHANGE_ME

# 超级管理员密码（请修改为强密码）
HALO_SECURITY_INITIALIZER_SUPERADMINPASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
